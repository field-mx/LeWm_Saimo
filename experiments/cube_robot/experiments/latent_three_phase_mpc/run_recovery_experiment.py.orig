)


STATE_NAMES = ("align", "grasp", "transfer", "release", "retreat")
ALIGN, GRASP, TRANSFER, RELEASE, RETREAT = range(len(STATE_NAMES))
PREDICATE_NAMES = (
    "aligned",
    "grasped",
    "near_goal",
    "released",
    "retreated",
    "complete",
)
ALIGNED, GRASPED, NEAR_GOAL, RELEASED, RETREATED, COMPLETE = range(
    len(PREDICATE_NAMES)
)
ACTION_RANGE = np.asarray([0.05, 0.05, 0.05, 0.30, 1.0], dtype=np.float32)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="RGB-only latent MPC with a recoverable semantic state machine."
    )
    parser.add_argument(
        "--config", type=Path, default=HERE / "recovery_config.yaml"
    )
    parser.add_argument(
        "--stage",
        choices=("collect", "train", "adapt", "all"),
        default="all",
    )
    parser.add_argument("--smoke", action="store_true")
    parser.add_argument("--regenerate-data", action="store_true")
    parser.add_argument(
        "--resume-checkpoint",
        type=Path,
        default=None,
        help="Checkpoint to continue online Actor adaptation from.",
    )
    parser.add_argument(
        "--run-name",
        type=str,
        default="recovery_state_machine",
        help="Separate name for online logs, videos, summary, and checkpoint.",
    )
    return parser.parse_args()


def apply_smoke_config(config: dict[str, Any]) -> None:
    config["paths"]["output_dir"] = (
        config["paths"]["output_dir"] / "recovery_smoke"
    )
    config["teacher"].update(
        episodes=4,
        max_steps=100,
        reuse_dataset=False,
    )
    config["training"].update(epochs=2, batch_size=32)
    config["planner"].update(num_candidates=8, horizon_blocks=2)
    config["online_training"].update(
        episodes=2,
        max_steps=30,
        warmup_samples=2,
        batch_size=8,
    )


def set_seed(seed: int) -> None:
    random.seed(seed)
    np.random.seed(seed)
    torch.manual_seed(seed)
    if torch.cuda.is_available():
        torch.cuda.manual_seed_all(seed)


def append_jsonl(path: Path, value: dict[str, Any]) -> None:
    base.append_jsonl(path, value)


def save_json(path: Path, value: dict[str, Any]) -> None:
    base.save_json(path, value)


def predicate_labels(value, settings: dict[str, Any]) -> np.ndarray:
    effector_cube_xy = float(
        np.linalg.norm(value.effector[:2] - value.cube[:2])
    )
    effector_cube_xyz = float(np.linalg.norm(value.effector - value.cube))
    cube_goal_xyz = float(np.linalg.norm(value.cube - value.goal))
    grasped = value.contact >= float(settings["contact_threshold"])
    aligned = (
        not grasped
        and effector_cube_xy <= float(settings["xy_alignment_m"])
        and effector_cube_xyz <= float(settings["xyz_alignment_m"]) * 1.4
    )
    near_goal = cube_goal_xyz <= float(settings["goal_xyz_m"])
    released = (
        near_goal
        and value.contact < float(settings["release_contact_threshold"])
    )
    retreated = (
        released
        and effector_cube_xyz >= float(settings["retreat_distance_m"])
    )
    complete = retreated and value.effector[2] >= (
        value.cube[2] + 0.5 * float(settings["retreat_distance_m"])
    )
    return np.asarray(
        [aligned, grasped, near_goal, released, retreated, complete],
        dtype=np.float32,
    )


def state_from_labels(labels: np.ndarray) -> int:
    if bool(labels[RELEASED]):
        return RETREAT
    if bool(labels[GRASPED]) and bool(labels[NEAR_GOAL]):
        return RELEASE
    if bool(labels[GRASPED]):
        return TRANSFER
    if bool(labels[ALIGNED]):
        return GRASP
    return ALIGN


def keyframe_reached(labels: np.ndarray, state_id: int) -> bool:
    if state_id == ALIGN:
        return bool(labels[ALIGNED])
    if state_id == GRASP:
        return bool(labels[GRASPED])
    if state_id == TRANSFER:
        return bool(labels[GRASPED] and labels[NEAR_GOAL])
    if state_id == RELEASE:
        return bool(labels[RELEASED])
    return bool(labels[COMPLETE])


def keyframe_endpoint(
    labels: np.ndarray,
    index: int,
    state_id: int,
) -> int:
    for future in range(index, len(labels)):
        if keyframe_reached(labels[future], state_id):
            return future
    return len(labels) - 1


def recovery_teacher_action(
    teacher: PrivilegedTeacher,
    state: np.ndarray,
    goal_state: np.ndarray,
    settings: dict[str, Any],
) -> tuple[np.ndarray, str, np.ndarray]:
    value = semantic_state(state, goal_state)
    labels = predicate_labels(value, settings)
    if labels[COMPLETE]:
        action = np.zeros(5, dtype=np.float32)
        action[4] = -1.0
        return action, "complete", labels

    if labels[RELEASED]:
        target = value.effector.copy()
        target[2] = max(
            float(target[2]),
            float(value.cube[2]) + float(settings["retreat_height_m"]),
        )
        action = np.zeros(5, dtype=np.float32)
        action[:3] = np.clip(
            (target - value.effector) / ACTION_RANGE[:3], -1.0, 1.0
        )
        action[4] = -1.0
        return action, "retreat", labels

    if labels[GRASPED] and labels[NEAR_GOAL]:
        action = np.zeros(5, dtype=np.float32)
        action[4] = -1.0
        return action, "release", labels

    action, fine_phase = teacher.action(state, goal_state, settings)
    return np.asarray(action, dtype=np.float32), fine_phase, labels


def collect_recovery_dataset(
    config: dict[str, Any],
    world_model,
    transform,
    device: torch.device,
    dataset_path: Path,
    log_path: Path,
) -> dict[str, Any]:
    if dataset_path.exists() and bool(config["teacher"]["reuse_dataset"]):
        with np.load(dataset_path) as dataset:
            return {
                "reused": True,
                "samples": int(len(dataset["latents"])),
                "episodes": int(len(np.unique(dataset["episode_ids"]))),
                "successes": int(
                    sum(
                        np.max(dataset["episode_successes"][
                            dataset["episode_ids"] == episode
                        ])
                        for episode in np.unique(dataset["episode_ids"])
                    )
                ),
            }

    settings = config["teacher"]
    training = config["training"]
    block = int(config["model"]["action_block"])
    teacher = PrivilegedTeacher(config["paths"]["coordinate_actor_checkpoint"])
    env = ogbench.make_env_and_datasets(
        "cube-single-play-v0",
        env_only=True,
        terminate_at_goal=False,
    )
    rng = np.random.default_rng(int(config["seed"]) + 73)
    log_path.unlink(missing_ok=True)
    array_names = (
        "previous_latents",
        "latents",
        "next_latents",
        "goal_latents",
        "keyframe_target_latents",
        "next_keyframe_target_latents",
        "action_blocks",
        "state_ids",
        "next_state_ids",
        "predicate_targets",
        "rewards",
        "dones",
        "episode_ids",
        "episode_successes",
    )
    arrays: dict[str, list[np.ndarray]] = {name: [] for name in array_names}
    successes = 0
    state_counts: Counter[int] = Counter()
    predicate_counts = np.zeros(len(PREDICATE_NAMES), dtype=np.int64)

    for episode in range(int(settings["episodes"])):
        state, reset_info = env.reset(
            seed=int(config["seed"]) + int(settings["seed_offset"]) + episode,
            options=base.task_reset_options(config),
        )
        goal_state = np.asarray(reset_info["goal"], dtype=np.float32)
        goal_image = np.asarray(reset_info["goal_rendered"]).copy()
        frames = [np.asarray(env.render()).copy()]
        ideal_actions: list[np.ndarray] = []
        labels_per_frame: list[np.ndarray] = []
        fine_states: list[str] = []
        stable_complete = 0
        terminated = False
        truncated = False

        for _ in range(int(settings["max_steps"])):
            ideal_action, fine_state, labels = recovery_teacher_action(
                teacher, state, goal_state, settings
            )
            labels_per_frame.append(labels)
            fine_states.append(fine_state)
            stable_complete = stable_complete + 1 if labels[COMPLETE] else 0
            if stable_complete >= int(settings["stable_complete_frames"]):
                break

            noise = rng.normal(
                0.0,
                float(settings["action_noise_std"]),
                size=ideal_action.shape,
            )
            if fine_state in ("release", "retreat", "complete"):
                noise[4] = 0.0
            executed_action = np.clip(
                ideal_action + noise, -1.0, 1.0
            ).astype(np.float32)
            ideal_actions.append(ideal_action.astype(np.float32))
            state, _, terminated, truncated, _ = env.step(executed_action)
            frames.append(np.asarray(env.render()).copy())
            if terminated or truncated:
                break

        if len(labels_per_frame) < len(frames):
            labels_per_frame.append(
                predicate_labels(semantic_state(state, goal_state), settings)
            )
            fine_states.append("terminal")
        labels_np = np.asarray(labels_per_frame[: len(frames)], dtype=np.float32)
        success = bool(labels_np[-1, COMPLETE])
        successes += int(success)

        latents = base.encode_images(world_model, frames, transform, device)
        goal_latent = base.encode_images(
            world_model, [goal_image], transform, device
        )[0]
        state_ids = np.asarray(
            [state_from_labels(labels) for labels in labels_np], dtype=np.int64
        )
        state_counts.update(state_ids.tolist())
        predicate_counts += labels_np.astype(bool).sum(axis=0)
        terminal = len(frames) - 1

        for index in range(len(frames)):
            next_index = min(index + 1, terminal)
            state_id = int(state_ids[index])
            next_state_id = int(state_ids[next_index])
            endpoint = keyframe_endpoint(labels_np, index, state_id)
            next_endpoint = keyframe_endpoint(
                labels_np, next_index, next_state_id
            )
            reward = 0.0
            if index < terminal:
                reward -= float(training["step_penalty"])
                if next_state_id > state_id:
                    reward += float(training["state_transition_reward"])
                elif next_state_id < state_id:
                    reward -= float(training["recovery_penalty"])
                if success and bool(labels_np[next_index, COMPLETE]):
                    reward += float(training["success_reward"])

            arrays["previous_latents"].append(latents[max(0, index - 1)])
            arrays["latents"].append(latents[index])
            arrays["next_latents"].append(latents[next_index])
            arrays["goal_latents"].append(goal_latent)
            arrays["keyframe_target_latents"].append(latents[endpoint])
            arrays["next_keyframe_target_latents"].append(
                latents[next_endpoint]
            )
            arrays["action_blocks"].append(
                base.action_block(ideal_actions, index, block).reshape(-1)
            )
            arrays["state_ids"].append(
                np.asarray(state_id, dtype=np.int64)
            )
            arrays["next_state_ids"].append(
                np.asarray(next_state_id, dtype=np.int64)
            )
            arrays["predicate_targets"].append(labels_np[index])
            arrays["rewards"].append(np.asarray(reward, dtype=np.float32))
            arrays["dones"].append(
                np.asarray(index == terminal, dtype=np.float32)
            )
            arrays["episode_ids"].append(
                np.asarray(episode, dtype=np.int64)
            )
            arrays["episode_successes"].append(
                np.asarray(success, dtype=np.int64)
            )

        record = {
            "episode": episode,
            "steps": len(ideal_actions),
            "frames": len(frames),
            "complete": success,
            "terminated": bool(terminated),
            "truncated": bool(truncated),
            "fine_state_counts": dict(Counter(fine_states)),
            "state_counts": {
                STATE_NAMES[key]: int(value)
                for key, value in Counter(state_ids.tolist()).items()
            },
            "predicate_counts": {
                name: int(labels_np[:, index].sum())
                for index, name in enumerate(PREDICATE_NAMES)
            },
        }
        append_jsonl(log_path, record)
        print(json.dumps(record))

    env.close()
    if successes < 2:
        raise RuntimeError(
            "The recovery teacher produced fewer than two complete trajectories."
        )
    dataset_path.parent.mkdir(parents=True, exist_ok=True)
    np.savez_compressed(
        dataset_path,
        **{name: np.asarray(values) for name, values in arrays.items()},
    )
    return {
        "reused": False,
        "samples": len(arrays["latents"]),
        "episodes": int(settings["episodes"]),
        "successes": successes,
        "state_counts": {
            STATE_NAMES[key]: int(value) for key, value in state_counts.items()
        },
        "predicate_counts": {
            name: int(predicate_counts[index])
            for index, name in enumerate(PREDICATE_NAMES)
        },
    }


DATASET_KEYS = (
    "previous_latents",
    "latents",
    "next_latents",
    "goal_latents",
    "keyframe_target_latents",
    "next_keyframe_target_latents",
    "action_blocks",
    "state_ids",
    "next_state_ids",
    "predicate_targets",
    "rewards",
    "dones",
)


def dataset_tensors(
    dataset: np.lib.npyio.NpzFile,
    indices: np.ndarray,
) -> TensorDataset:
    tensors = []
    for name in DATASET_KEYS:
        values = np.asarray(dataset[name][indices])
        if name in ("state_ids", "next_state_ids"):
            tensors.append(torch.from_numpy(values.astype(np.int64)))
        else:
            tensors.append(torch.from_numpy(values.astype(np.float32)))
    return TensorDataset(*tensors)


def build_models(config: dict[str, Any], device: torch.device):
    settings = config["model"]
    latent_dim = int(settings["latent_dim"])
    hidden_dim = int(settings["hidden_dim"])
    state_count = int(settings["state_count"])
    semantic_net = VisualSemanticNet(
        latent_dim,
        hidden_dim,
        int(settings["predicate_count"]),
    ).to(device)
    target_net = RecoveryTargetNet(
        latent_dim, hidden_dim, state_count
    ).to(device)
    actor = RecoveryBlockActor(
        latent_dim,
        int(settings["action_dim"]),
        int(settings["action_block"]),
        hidden_dim,
        state_count,
    ).to(device)
    critic = RecoveryValueEnsemble(
        latent_dim,
        hidden_dim,
        state_count,
        int(settings["value_ensemble_size"]),
    ).to(device)
    return semantic_net, target_net, actor, critic


def model_losses(
    *,
    semantic_net: VisualSemanticNet,
    target_net: RecoveryTargetNet,
    actor: RecoveryBlockActor,
    critic: RecoveryValueEnsemble,
    target_critic: RecoveryValueEnsemble,
    batch: tuple[torch.Tensor, ...],
    settings: dict[str, Any],
    positive_weights: torch.Tensor,
    device: torch.device,
) -> tuple[torch.Tensor, dict[str, float]]:
    (
        previous,
        current,
        next_latent,
        goal,
        keyframe_target,
        next_keyframe_target,
        action_blocks,
        state_id,
        next_state_id,
        predicates,
        reward,
        done,
    ) = [item.to(device) for item in batch]

    predicate_logits = semantic_net(previous, current, goal)
    predicted_target = target_net(previous, current, goal, state_id)
    predicted_actions = actor.mean(
        previous, current, keyframe_target, goal, state_id
    )
    values = critic(previous, current, keyframe_target, goal, state_id)
    with torch.no_grad():
        next_values = target_critic(
            current,
            next_latent,
            next_keyframe_target,
            goal,
            next_state_id,
        ).mean(dim=0)
        td_target = reward + float(settings["gamma"]) * (1.0 - done) * next_values

    semantic_loss = nn.functional.binary_cross_entropy_with_logits(
        predicate_logits,
        predicates,
        pos_weight=positive_weights,
    )
    target_loss = nn.functional.mse_loss(predicted_target, keyframe_target)
    actor_loss = nn.functional.mse_loss(predicted_actions, action_blocks)
    critic_loss = nn.functional.mse_loss(
        values, td_target.unsqueeze(0).expand_as(values)
    )
    total = (
        float(settings["semantic_coefficient"]) * semantic_loss
        + float(settings["target_coefficient"]) * target_loss
        + float(settings["actor_coefficient"]) * actor_loss
        + float(settings["critic_coefficient"]) * critic_loss
    )
    with torch.no_grad():
        predictions = torch.sigmoid(predicate_logits) >= 0.5
        predicate_accuracy = (predictions == predicates.bool()).float().mean()
        complete_recall = (
            predictions[:, COMPLETE][predicates[:, COMPLETE].bool()]
            .float()
            .mean()
            if predicates[:, COMPLETE].bool().any()
            else torch.ones((), device=device)
        )
    return total, {
        "loss": float(total.detach().item()),
        "semantic_loss": float(semantic_loss.detach().item()),
        "target_loss": float(target_loss.detach().item()),
        "actor_loss": float(actor_loss.detach().item()),
        "critic_loss": float(critic_loss.detach().item()),
        "predicate_accuracy": float(predicate_accuracy.detach().item()),
        "complete_recall": float(complete_recall.detach().item()),
    }


def save_checkpoint(
    path: Path,
    config: dict[str, Any],
    semantic_net: VisualSemanticNet,
    target_net: RecoveryTargetNet,
    actor: RecoveryBlockActor,
    critic: RecoveryValueEnsemble,
    action_mean: np.ndarray,
    action_scale: np.ndarray,
    extra: dict[str, Any],
) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    torch.save(
        {
            "semantic_net": semantic_net.state_dict(),
            "target_net": target_net.state_dict(),
            "actor": actor.state_dict(),
            "critic": critic.state_dict(),
            "action_mean": action_mean,
            "action_scale": action_scale,
            "config": base.json_value(config),
            "extra": base.json_value(extra),
        },
        path,
    )


def load_checkpoint(
    path: Path,
    config: dict[str, Any],
    device: torch.device,
):
    checkpoint = torch.load(path, map_location="cpu", weights_only=False)
    semantic_net, target_net, actor, critic = build_models(config, device)
    semantic_net.load_state_dict(checkpoint["semantic_net"])
    target_net.load_state_dict(checkpoint["target_net"])
    actor.load_state_dict(checkpoint["actor"])
    critic.load_state_dict(checkpoint["critic"])
    for model in (semantic_net, target_net, actor, critic):
        model.eval()
    return (
        semantic_net,
        target_net,
        actor,
        critic,
        np.asarray(checkpoint["action_mean"], dtype=np.float32),
        np.asarray(checkpoint["action_scale"], dtype=np.float32),
    )


def train_offline(
    config: dict[str, Any],
    dataset_path: Path,
    device: torch.device,
    checkpoint_path: Path,
    log_path: Path,
    action_mean: np.ndarray,
    action_scale: np.ndarray,
):
    settings = config["training"]
    semantic_net, target_net, actor, critic = build_models(config, device)
    target_critic = copy.deepcopy(critic).eval().requires_grad_(False)
    with np.load(dataset_path) as dataset:
        episode_ids = np.asarray(dataset["episode_ids"], dtype=np.int64)
        episodes = np.unique(episode_ids)
        rng = np.random.default_rng(int(config["seed"]))
        rng.shuffle(episodes)
        validation_count = max(
            1,
            int(round(len(episodes) * float(settings["validation_fraction"]))),
        )
        validation_mask = np.isin(episode_ids, episodes[:validation_count])
        train_indices = np.flatnonzero(~validation_mask)
        validation_indices = np.flatnonzero(validation_mask)
        train_dataset = dataset_tensors(dataset, train_indices)
        validation_dataset = dataset_tensors(dataset, validation_indices)
        predicate_targets = np.asarray(
            dataset["predicate_targets"][train_indices], dtype=np.float32
        )

    positive = predicate_targets.sum(axis=0)
    negative = len(predicate_targets) - positive
    weights_np = np.clip(
        negative / np.maximum(positive, 1.0),
        1.0,
        float(settings["max_positive_weight"]),
    ).astype(np.float32)
    positive_weights = torch.from_numpy(weights_np).to(device)
    generator = torch.Generator().manual_seed(int(config["seed"]))
    train_loader = DataLoader(
        train_dataset,
        batch_size=int(settings["batch_size"]),
        shuffle=True,
        generator=generator,
    )
    validation_loader = DataLoader(
        validation_dataset,
        batch_size=int(settings["batch_size"]),
        shuffle=False,
    )
    models = (semantic_net, target_net, actor, critic)
    parameters = [parameter for model in models for parameter in model.parameters()]
    optimizer = torch.optim.AdamW(
        parameters,
        lr=float(settings["learning_rate"]),
        weight_decay=float(settings["weight_decay"]),
    )
    best_validation = float("inf")
    best_state = None
    log_path.unlink(missing_ok=True)

    for epoch in range(1, int(settings["epochs"]) + 1):
        for model in models:
            model.train()
        train_metrics = []
        for batch in train_loader:
            loss, metrics = model_losses(
                semantic_net=semantic_net,
                target_net=target_net,
                actor=actor,
                critic=critic,
                target_critic=target_critic,
                batch=batch,
                settings=settings,
                positive_weights=positive_weights,
                device=device,
            )
            optimizer.zero_grad(set_to_none=True)
            loss.backward()
            nn.utils.clip_grad_norm_(
                parameters, float(settings["max_grad_norm"])
            )
            optimizer.step()
            base.soft_update(
                target_critic, critic, float(settings["target_tau"])
            )
            train_metrics.append(metrics)

        for model in models:
            model.eval()
        validation_metrics = []
        with torch.inference_mode():
            for batch in validation_loader:
                _, metrics = model_losses(
                    semantic_net=semantic_net,
                    target_net=target_net,
                    actor=actor,
                    critic=critic,
                    target_critic=target_critic,
                    batch=batch,
                    settings=settings,
                    positive_weights=positive_weights,
                    device=device,
                )
                validation_metrics.append(metrics)

        train_mean = {
            key: float(np.mean([item[key] for item in train_metrics]))
            for key in train_metrics[0]
        }
        validation_mean = {
            key: float(np.mean([item[key] for item in validation_metrics]))
            for key in validation_metrics[0]
        }
        record = {
            "epoch": epoch,
            "train": train_mean,
            "validation": validation_mean,
            "predicate_positive_weights": {
                name: float(weights_np[index])
                for index, name in enumerate(PREDICATE_NAMES)
            },
        }
        append_jsonl(log_path, record)
        if epoch == 1 or epoch % 10 == 0 or epoch == int(settings["epochs"]):
            print(json.dumps(record))
        if validation_mean["loss"] < best_validation:
            best_validation = validation_mean["loss"]
            best_state = {
                "epoch": epoch,
                "semantic_net": copy.deepcopy(semantic_net.state_dict()),
                "target_net": copy.deepcopy(target_net.state_dict()),
                "actor": copy.deepcopy(actor.state_dict()),
                "critic": copy.deepcopy(critic.state_dict()),
            }

    if best_state is None:
        raise RuntimeError("Recovery training did not produce a checkpoint.")
    semantic_net.load_state_dict(best_state["semantic_net"])
    target_net.load_state_dict(best_state["target_net"])
    actor.load_state_dict(best_state["actor"])
    critic.load_state_dict(best_state["critic"])
    save_checkpoint(
        checkpoint_path,
        config,
        semantic_net,
        target_net,
        actor,
        critic,
        action_mean,
        action_scale,
        {
            "best_epoch": best_state["epoch"],
            "best_validation_loss": best_validation,
            "predicate_positive_weights": weights_np,
        },
    )
    return tuple(model.eval() for model in models)


@torch.inference_mode()
def semantic_probabilities(
    semantic_net: VisualSemanticNet,
    previous: torch.Tensor,
    current: torch.Tensor,
    goal: torch.Tensor,
) -> torch.Tensor:
    return torch.sigmoid(semantic_net(previous, current, goal))[0]


@torch.inference_mode()
def critic_statistics(
    critic: RecoveryValueEnsemble,
    previous: torch.Tensor,
    current: torch.Tensor,
    target: torch.Tensor,
    goal: torch.Tensor,
    state: torch.Tensor,
) -> tuple[torch.Tensor, torch.Tensor]:
    values = critic(previous, current, target, goal, state)
    return values.mean(dim=0), values.std(dim=0, unbiased=False)


def desired_state_from_probabilities(
    probabilities: np.ndarray,
    thresholds: np.ndarray,
) -> int:
    active = probabilities >= thresholds
    if active[RELEASED] or (
        active[NEAR_GOAL] and not active[GRASPED]
    ):
        return RETREAT
    if active[GRASPED] and active[NEAR_GOAL]:
        return RELEASE
    if active[GRASPED]:
        return TRANSFER
    if active[ALIGNED]:
        return GRASP
    return ALIGN


@dataclass
class StateTransition:
    previous: int
    current: int
    changed: bool
    rollback: bool
    forced_recovery: bool
    visually_complete: bool


class RecoveryStateMachine:
    def __init__(self, settings: dict[str, Any]) -> None:
        self.settings = settings
        self.thresholds = np.asarray(
            settings["predicate_thresholds"], dtype=np.float32
        )
        self.state = ALIGN
        self.pending_state = ALIGN
        self.pending_streak = 0
        self.complete_streak = 0
        self.cooldown = 0
        self.steps_in_state = 0
        self.recoveries = 0
        self.visually_complete = False

    def initialize(self, probabilities: np.ndarray) -> int:
        self.state = desired_state_from_probabilities(
            probabilities, self.thresholds
        )
        self.pending_state = self.state
        return self.state

    def _forced_recovery_state(self, probabilities: np.ndarray) -> int:
        active = probabilities >= self.thresholds
        if self.state == GRASP:
            return ALIGN
        if self.state == TRANSFER and not active[GRASPED]:
            return GRASP if active[ALIGNED] else ALIGN
        if self.state == RELEASE:
            if active[GRASPED]:
                return TRANSFER
            return GRASP if active[ALIGNED] else ALIGN
        if self.state == RETREAT and not active[RELEASED]:
            return GRASP if active[ALIGNED] else ALIGN
        return self.state

    def observe(self, probabilities: np.ndarray) -> StateTransition:
        previous = self.state
        self.steps_in_state += 1
        self.cooldown = max(0, self.cooldown - 1)
        if probabilities[COMPLETE] >= self.thresholds[COMPLETE]:
            self.complete_streak += 1
        else:
            self.complete_streak = 0
        self.visually_complete = self.complete_streak >= int(
            self.settings["complete_consecutive_frames"]
        )
        if self.visually_complete:
            return StateTransition(
                previous, self.state, False, False, False, True
            )

        desired = desired_state_from_probabilities(
            probabilities, self.thresholds
        )
        forced_recovery = False
        max_steps = int(self.settings["max_state_steps"][self.state])
        if self.steps_in_state >= max_steps:
            forced = self._forced_recovery_state(probabilities)
            if forced != self.state:
                desired = forced
                forced_recovery = True

        if desired == self.state:
            self.pending_state = self.state
            self.pending_streak = 0
            return StateTransition(
                previous, self.state, False, False, False, False
            )

        if desired == self.pending_state:
            self.pending_streak += 1
        else:
            self.pending_state = desired
            self.pending_streak = 1
        required = int(self.settings["transition_consecutive_frames"])
        if forced_recovery:
            required = 1
        if self.cooldown > 0 or self.pending_streak < required:
            return StateTransition(
                previous,
                self.state,
                False,
                False,
                forced_recovery,
                False,
            )

        self.state = desired
        self.steps_in_state = 0
        self.pending_streak = 0
        self.cooldown = int(self.settings["transition_cooldown_steps"])
        rollback = self.state < previous
        if rollback or forced_recovery:
            self.recoveries += 1
        return StateTransition(
            previous, self.state, True, rollback, forced_recovery, False
        )
@torch.inference_mode()
def propose_and_score(
    *,
    actor: RecoveryBlockActor,
    target_net: RecoveryTargetNet,
    critic: RecoveryValueEnsemble,
    world_model,
    previous: torch.Tensor,
    current: torch.Tensor,
    goal: torch.Tensor,
    state_id: int,
    action_mean: np.ndarray,
    action_scale: np.ndarray,
    settings: dict[str, Any],
    rng: np.random.Generator,
) -> dict[str, Any]:
    device = current.device
    count = int(settings["num_candidates"])
    horizon = int(settings["horizon_blocks"])
    block = actor.action_block
    action_dim = actor.action_dim
    actual_state = torch.full(
        (1,), state_id, dtype=torch.long, device=device
    )
    keyframe_target = target_net(previous, current, goal, actual_state)
    candidate_previous = previous.expand(count, -1).clone()
    candidate_current = current.expand(count, -1).clone()
    candidate_goal = goal.expand(count, -1)
    candidate_target = keyframe_target.expand(count, -1)
    candidate_state = actual_state.expand(count)
    mean_tensor = torch.as_tensor(action_mean, device=device)
    scale_tensor = torch.as_tensor(action_scale, device=device)
    exploration = float(settings["exploration_std"])
    blocks = []
    values_along_path = []
    predicted_latents = []

    for _ in range(horizon):
        mean_block = actor.mean(
            candidate_previous,
            candidate_current,
            candidate_target,
            candidate_goal,
            candidate_state,
        ).reshape(count, block, action_dim)
        noise = torch.from_numpy(
            rng.normal(
                0.0,
                exploration,
                size=(count, block, action_dim),
            ).astype(np.float32)
        ).to(device)
        noise[0].zero_()
        raw_block = (mean_block + noise).clamp(-1.0, 1.0)
        if state_id == ALIGN:
            raw_block[..., 4].clamp_(max=-0.35)
        elif state_id in (GRASP, TRANSFER):
            raw_block[..., 4].clamp_(min=0.35)
        else:
            raw_block[..., 4].clamp_(max=-0.35)
        normalized = ((raw_block - mean_tensor) / scale_tensor).reshape(
            count, -1
        )
        next_latent = base.predict_latent_block(
            world_model, candidate_current, normalized
        )
        step_value, _ = critic_statistics(
            critic,
            candidate_current,
            next_latent,
            candidate_target,
            candidate_goal,
            candidate_state,
        )
        blocks.append(raw_block)
        values_along_path.append(step_value)
        predicted_latents.append(next_latent)
        candidate_previous, candidate_current = candidate_current, next_latent
        exploration *= float(settings["exploration_decay"])

    plans = torch.stack(blocks, dim=1)
    flattened = plans.reshape(count, horizon * block, action_dim)
    terminal = predicted_latents[-1]
    terminal_value, uncertainty = critic_statistics(
        critic,
        candidate_previous,
        terminal,
        candidate_target,
        candidate_goal,
        candidate_state,
    )
    trajectory_value = torch.stack(values_along_path, dim=1).mean(dim=1)
    short_cost = (terminal - candidate_target).square().mean(dim=-1)
    behavior_deviation = (
        plans - plans[0:1]
    ).square().mean(dim=(1, 2, 3))
    smoothness = (
        flattened[:, 1:] - flattened[:, :-1]
    ).square().mean(dim=(1, 2))
    score = (
        -float(settings["short_target_coefficient"]) * short_cost
        + float(settings["terminal_value_coefficient"]) * terminal_value
        + float(settings["trajectory_value_coefficient"]) * trajectory_value
        - float(settings["uncertainty_coefficient"]) * uncertainty
        - float(settings["action_prior_coefficient"]) * behavior_deviation
        - float(settings["action_smoothness_coefficient"]) * smoothness
    )
    best_index = int(torch.argmax(score).item())
    elite_count = min(int(settings["elite_count"]), count)
    elite_scores, elite_indices = torch.topk(score, elite_count)
    temperature = max(float(settings["elite_temperature"]), 1e-6)
    weights = torch.softmax(
        (elite_scores - elite_scores.max()) / temperature, dim=0
    )
    elite_plan = (
        flattened[elite_indices] * weights[:, None, None]
    ).sum(dim=0)
    return {
        "flattened": flattened,
        "score": score,
        "best_index": best_index,
        "keyframe_target": keyframe_target,
        "elite_plan": elite_plan,
        "terminal_value": terminal_value,
        "trajectory_value": trajectory_value,
        "uncertainty": uncertainty,
        "short_cost": short_cost,
    }


def update_actor_online(
    actor: RecoveryBlockActor,
    anchor_actor: RecoveryBlockActor,
    optimizer: torch.optim.Optimizer,
    replay: deque,
    settings: dict[str, Any],
    rng: np.random.Generator,
    device: torch.device,
) -> float:
    actor.train()
    losses = []
    for _ in range(int(settings["updates_per_step"])):
        count = min(int(settings["batch_size"]), len(replay))
        indices = rng.choice(len(replay), size=count, replace=False)
        previous = torch.stack([replay[int(i)][0] for i in indices]).to(device)
        current = torch.stack([replay[int(i)][1] for i in indices]).to(device)
        target = torch.stack([replay[int(i)][2] for i in indices]).to(device)
        goal = torch.stack([replay[int(i)][3] for i in indices]).to(device)
        state = torch.stack([replay[int(i)][4] for i in indices]).to(device)
        action_target = torch.stack(
            [replay[int(i)][5] for i in indices]
        ).to(device)
        prediction = actor.mean(
            previous, current, target, goal, state
        ).reshape(count, actor.action_block, actor.action_dim)
        with torch.no_grad():
            anchor = anchor_actor.mean(
                previous, current, target, goal, state
            ).reshape(count, actor.action_block, actor.action_dim)
        selected_loss = nn.functional.mse_loss(
            prediction[:, 0], action_target
        )
        anchor_loss = nn.functional.mse_loss(prediction, anchor)
        loss = selected_loss + float(
            settings["bc_anchor_coefficient"]
        ) * anchor_loss
        optimizer.zero_grad(set_to_none=True)
        loss.backward()
        nn.utils.clip_grad_norm_(
            actor.parameters(), float(settings["max_grad_norm"])
        )
        optimizer.step()
        losses.append(float(loss.item()))
    actor.eval()
    return float(np.mean(losses))


def active_semantic_progress(
    before: np.ndarray,
    after: np.ndarray,
    state_id: int,
) -> float:
    predicate_index = {
        ALIGN: ALIGNED,
        GRASP: GRASPED,
        TRANSFER: NEAR_GOAL,
        RELEASE: RELEASED,
        RETREAT: COMPLETE,
    }[state_id]
    return float(after[predicate_index] - before[predicate_index])


def semantic_safety_ok(
    before: np.ndarray,
    after: np.ndarray,
    state_id: int,
) -> bool:
    if state_id == TRANSFER:
        return bool(after[GRASPED] >= before[GRASPED] - 0.10)
    if state_id in (RELEASE, RETREAT):
        return bool(after[NEAR_GOAL] >= before[NEAR_GOAL] - 0.10)
    return True


def save_video(path: Path, frames: list[np.ndarray], fps: int) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    imageio.mimsave(path, frames, fps=fps)

def run_online_training(
    *,
    config: dict[str, Any],
    semantic_net: VisualSemanticNet,
    target_net: RecoveryTargetNet,
    actor: RecoveryBlockActor,
    critic: RecoveryValueEnsemble,
    world_model,
    transform,
    device: torch.device,
    action_mean: np.ndarray,
    action_scale: np.ndarray,
    log_path: Path,
    video_dir: Path,
) -> dict[str, Any]:
    settings = config["online_training"]
    planner = config["planner"]
    state_settings = config["state_machine"]
    rng = np.random.default_rng(
        int(config["seed"]) + int(settings["seed_offset"])
    )
    env = ogbench.make_env_and_datasets(
        "cube-single-play-v0",
        env_only=True,
        terminate_at_goal=False,
    )
    anchor_actor = copy.deepcopy(actor).eval().requires_grad_(False)
    optimizer = torch.optim.AdamW(
        actor.parameters(),
        lr=float(settings["learning_rate"]),
        weight_decay=1e-5,
    )
    replay = deque(maxlen=int(settings["replay_capacity"]))
    log_path.unlink(missing_ok=True)
    video_dir.mkdir(parents=True, exist_ok=True)
    episode_results = []
    world_model_seconds = 0.0
    world_model_calls = 0
    total_recoveries = 0

    for episode in range(int(settings["episodes"])):
        _, reset_info = env.reset(
            seed=int(config["seed"]) + int(settings["seed_offset"]) + episode,
            options=base.task_reset_options(config),
        )
        goal_image = np.asarray(reset_info["goal_rendered"]).copy()
        goal_latent = base.encode_image(
            world_model, goal_image, transform, device
        )
        current_image = np.asarray(env.render()).copy()
        current_latent = base.encode_image(
            world_model, current_image, transform, device
        )
        previous_latent = current_latent.clone()
        current_probabilities_t = semantic_probabilities(
            semantic_net,
            previous_latent,
            current_latent,
            goal_latent,
        )
        current_probabilities = (
            current_probabilities_t.detach().cpu().numpy()
        )
        state_machine = RecoveryStateMachine(state_settings)
        state_machine.initialize(current_probabilities)
        frames = [current_image]
        state_history = [state_machine.state]
        environment_step = 0
        planning_cycle = 0
        accepted_samples = 0
        online_updates = 0
        terminated = False
        truncated = False
        oracle_success_current = False

        while environment_step < int(settings["max_steps"]):
            state_id = state_machine.state
            if device.type == "cuda":
                torch.cuda.synchronize(device)
            started = time.perf_counter()
            proposal = propose_and_score(
                actor=actor,
                target_net=target_net,
                critic=critic,
                world_model=world_model,
                previous=previous_latent,
                current=current_latent,
                goal=goal_latent,
                state_id=state_id,
                action_mean=action_mean,
                action_scale=action_scale,
                settings=planner,
                rng=rng,
            )
            if device.type == "cuda":
                torch.cuda.synchronize(device)
            elapsed = time.perf_counter() - started
            world_model_seconds += elapsed
            world_model_calls += 1
            planning_cycle += 1
            best_index = int(proposal["best_index"])
            score = proposal["score"]
            planner_advantage = float(
                (score[best_index] - score[0]).detach().cpu().item()
            )
            base_plan = proposal["flattened"][0]
            planner_plan = proposal["flattened"][best_index]
            keyframe_target = proposal["keyframe_target"]
            execute_steps = min(
                int(planner["execute_steps_by_state"][state_id]),
                int(planner_plan.shape[0]),
                int(settings["max_steps"]) - environment_step,
            )
            blend = torch.as_tensor(
                planner["action_blend"],
                dtype=base_plan.dtype,
                device=base_plan.device,
            )

            for plan_action_index in range(execute_steps):
                state_before = state_machine.state
                state_tensor = torch.full(
                    (1,), state_before, dtype=torch.long, device=device
                )
                before_value, _ = critic_statistics(
                    critic,
                    previous_latent,
                    current_latent,
                    keyframe_target,
                    goal_latent,
                    state_tensor,
                )
                base_action = base_plan[plan_action_index]
                planned_action = planner_plan[plan_action_index]
                executed_action = torch.lerp(
                    base_action, planned_action, blend
                ).clamp(-1.0, 1.0)
                action = executed_action.detach().cpu().numpy()
                _, _, terminated, truncated, info = env.step(action)
                environment_step += 1
                oracle_success_current = bool(info.get("success", False))
                next_image = np.asarray(env.render()).copy()
                next_latent = base.encode_image(
                    world_model, next_image, transform, device
                )
                after_value, after_uncertainty = critic_statistics(
                    critic,
                    current_latent,
                    next_latent,
                    keyframe_target,
                    goal_latent,
                    state_tensor,
                )
                value_progress = float(
                    (after_value - before_value).detach().cpu().item()
                )
                next_probabilities_t = semantic_probabilities(
                    semantic_net,
                    current_latent,
                    next_latent,
                    goal_latent,
                )
                next_probabilities = (
                    next_probabilities_t.detach().cpu().numpy()
                )
                semantic_progress = active_semantic_progress(
                    current_probabilities,
                    next_probabilities,
                    state_before,
                )
                transition = state_machine.observe(next_probabilities)
                if transition.changed:
                    state_history.append(transition.current)

                value_ok = value_progress >= float(
                    settings["minimum_value_progress"]
                )
                semantic_ok = semantic_progress >= float(
                    settings["minimum_semantic_progress"]
                )
                progress_ok = semantic_ok or (
                    semantic_progress >= -0.01 and value_ok
                )
                accepted = (
                    planner_advantage
                    >= float(settings["minimum_planner_advantage"])
                    and progress_ok
                    and semantic_safety_ok(
                        current_probabilities,
                        next_probabilities,
                        state_before,
                    )
                )
                adaptation_loss = 0.0
                if accepted:
                    replay.append(
                        (
                            previous_latent[0].detach().cpu(),
                            current_latent[0].detach().cpu(),
                            keyframe_target[0].detach().cpu(),
                            goal_latent[0].detach().cpu(),
                            torch.tensor(state_before, dtype=torch.long),
                            torch.lerp(
                                base_action,
                                proposal["elite_plan"][plan_action_index],
                                blend,
                            ).detach().cpu(),
                        )
                    )
                    accepted_samples += 1
                    if len(replay) >= int(settings["warmup_samples"]):
                        adaptation_loss = update_actor_online(
                            actor,
                            anchor_actor,
                            optimizer,
                            replay,
                            settings,
                            rng,
                            device,
                        )
                        online_updates += 1

                record = {
                    "mode": "recovery_online_train",
                    "episode": episode,
                    "environment_step": environment_step,
                    "planning_cycle": planning_cycle,
                    "plan_action_index": plan_action_index,
                    "state_before": STATE_NAMES[state_before],
                    "state_after": STATE_NAMES[state_machine.state],
                    "state_changed": transition.changed,
                    "rollback": transition.rollback,
                    "forced_recovery": transition.forced_recovery,
                    "recovery_count": state_machine.recoveries,
                    "predicate_probabilities": {
                        name: float(next_probabilities[index])
                        for index, name in enumerate(PREDICATE_NAMES)
                    },
                    "visually_complete": transition.visually_complete,
                    "oracle_success_for_metrics_only": oracle_success_current,
                    "planner_advantage": planner_advantage,
                    "best_candidate": best_index,
                    "best_score": float(
                        score[best_index].detach().cpu().item()
                    ),
                    "short_target_cost": float(
                        proposal["short_cost"][best_index]
                        .detach()
                        .cpu()
                        .item()
                    ),
                    "predicted_terminal_value": float(
                        proposal["terminal_value"][best_index]
                        .detach()
                        .cpu()
                        .item()
                    ),
                    "predicted_value_uncertainty": float(
                        proposal["uncertainty"][best_index]
                        .detach()
                        .cpu()
                        .item()
                    ),
                    "real_rgb_value_progress": value_progress,
                    "real_rgb_value_uncertainty": float(
                        after_uncertainty.detach().cpu().item()
                    ),
                    "semantic_progress": semantic_progress,
                    "online_sample_accepted": accepted,
                    "adaptation_loss": adaptation_loss,
                    "executed_action": action,
                    "world_model_inference_seconds": (
                        elapsed if plan_action_index == 0 else 0.0
                    ),
                }
                append_jsonl(log_path, record)
                if (
                    environment_step == 1
                    or environment_step % 10 == 0
                    or transition.changed
                    or transition.visually_complete
                ):
                    print(json.dumps(base.json_value(record)))

                frames.append(next_image)
                previous_latent, current_latent = current_latent, next_latent
                current_probabilities = next_probabilities
                if (
                    transition.visually_complete
                    or terminated
                    or truncated
                    or transition.changed
                ):
                    break

            if state_machine.visually_complete or terminated or truncated:
                break

        success = bool(
            state_machine.visually_complete and oracle_success_current
        )
        status = "success" if success else "failed"
        video_path = video_dir / (
            f"recovery_online_episode_{episode}_{status}.mp4"
        )
        save_video(video_path, frames, int(settings["fps"]))
        total_recoveries += state_machine.recoveries
        result = {
            "episode": episode,
            "steps": environment_step,
            "success": success,
            "visually_complete": state_machine.visually_complete,
            "oracle_success_for_metrics_only": oracle_success_current,
            "terminated": bool(terminated),
            "truncated": bool(truncated),
            "state_history": [STATE_NAMES[index] for index in state_history],
            "recoveries": state_machine.recoveries,
            "accepted_online_samples": accepted_samples,
            "online_updates": online_updates,
            "video": str(video_path),
        }
        episode_results.append(result)
        append_jsonl(log_path, {"episode_summary": result})
        print(json.dumps(result))

    env.close()
    return {
        "mode": "recovery_online_train",
        "episodes": int(settings["episodes"]),
        "successes": int(sum(item["success"] for item in episode_results)),
        "total_recoveries": total_recoveries,
        "world_model_inference_seconds": world_model_seconds,
        "world_model_calls": world_model_calls,
        "mean_world_model_inference_seconds": world_model_seconds
        / max(1, world_model_calls),
        "episode_results": episode_results,
    }

def main() -> None:
    args = parse_args()
    if Path(args.run_name).name != args.run_name:
        raise ValueError("--run-name must be a single directory name.")
    config = base.load_config(args.config.resolve())
    if args.smoke:
        apply_smoke_config(config)
    if str(config["device"]).startswith("cuda") and not torch.cuda.is_available():
        raise RuntimeError("CUDA is required for recovery LeWM planning.")

    set_seed(int(config["seed"]))
    device = torch.device(config["device"])
    output_dir = config["paths"]["output_dir"]
    output_dir.mkdir(parents=True, exist_ok=True)
    dataset_path = output_dir / "data" / "recovery_semantic_latents.npz"
    offline_checkpoint = (
        output_dir / "checkpoints" / "recovery_actor_offline.pt"
    )
    final_checkpoint = (
        output_dir / "checkpoints" / f"{args.run_name}_actor_final.pt"
    )
    log_dir = output_dir / "logs" / args.run_name
    video_dir = output_dir / "videos" / args.run_name
    summary_path = output_dir / f"{args.run_name}_summary.json"
    save_json(
        output_dir / f"{args.run_name}_resolved_config.json", config
    )
    if args.regenerate_data:
        dataset_path.unlink(missing_ok=True)

    transform = base.build_transform(int(config["image_size"]))
    world_model = base.load_world_model(config["paths"]["model_dir"], device)
    action_mean, action_scale = base.load_action_stats(
        config["paths"]["action_dataset"]
    )
    summary: dict[str, Any] = {}

    if args.stage in ("collect", "all"):
        summary["collection"] = collect_recovery_dataset(
            config,
            world_model,
            transform,
            device,
            dataset_path,
            log_dir / "teacher_collection.jsonl",
        )
        if args.stage == "collect":
            save_json(summary_path, summary)
            print(json.dumps(base.json_value(summary), indent=2))
            return

    trained_models = None
    if args.stage in ("train", "all"):
        if not dataset_path.exists():
            raise FileNotFoundError(
                "Recovery dataset missing. Run --stage collect first."
            )
        trained_models = train_offline(
            config,
            dataset_path,
            device,
            offline_checkpoint,
            log_dir / "offline_training.jsonl",
            action_mean,
            action_scale,
        )
        summary["offline_training"] = {
            "checkpoint": str(offline_checkpoint)
        }

    if args.stage in ("adapt", "all"):
        if trained_models is None:
            source_checkpoint = (
                args.resume_checkpoint.expanduser().resolve()
                if args.resume_checkpoint is not None
                else offline_checkpoint
            )
            if not source_checkpoint.exists():
                raise FileNotFoundError(
                    f"Recovery checkpoint missing: {source_checkpoint}"
                )
            (
                semantic_net,
                target_net,
                actor,
                critic,
                action_mean,
                action_scale,
            ) = load_checkpoint(offline_checkpoint, config, device)
        else:
            semantic_net, target_net, actor, critic = trained_models
        for model in (semantic_net, target_net, critic):
            model.eval().requires_grad_(False)
        summary["online_training"] = run_online_training(
            config=config,
            semantic_net=semantic_net,
            target_net=target_net,
            actor=actor,
            critic=critic,
            world_model=world_model,
            transform=transform,
            device=device,
            action_mean=action_mean,
            action_scale=action_scale,
            log_path=log_dir / "online_training.jsonl",
            video_dir=video_dir,
        )
        save_checkpoint(
            final_checkpoint,
            config,
            semantic_net,
            target_net,
            actor,
            critic,
            action_mean,
            action_scale,
            {"online_training": summary["online_training"]},
        )
        summary["online_training"]["checkpoint"] = str(final_checkpoint)

    save_json(summary_path, summary)
    print(json.dumps(base.json_value(summary), indent=2))


if __name__ == "__main__":
    main()
