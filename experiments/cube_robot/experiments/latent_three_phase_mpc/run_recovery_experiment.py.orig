HERE = Path(__file__).resolve().parent
RGB_EXPERIMENT = HERE.parent / "rgb_latent_value_mpc"
for path in (RGB_EXPERIMENT, HERE):
    if str(path) in sys.path:
        sys.path.remove(str(path))
