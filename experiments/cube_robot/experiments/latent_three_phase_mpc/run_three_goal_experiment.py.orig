from __future__ import annotations

import argparse
import json
from pathlib import Path
from typing import Any

import numpy as np
import torch

import run_experiment as base
import run_recovery_experiment as recovery


HERE = Path(__file__).resolve().parent
PROCESS_NAMES = ("go_align", "go_grasp", "go_complete")
GO_ALIGN, GO_GRASP, GO_COMPLETE = range(len(PROCESS_NAMES))

ALIGNED = recovery.ALIGNED
GRASPED = recovery.GRASPED
NEAR_GOAL = recovery.NEAR_GOAL
RELEASED = recovery.RELEASED
RETREATED = recovery.RETREATED
COMPLETE = recovery.COMPLETE


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Retrain and run RGB-only MPC with three ordered goals: "
            "align, grasp, complete."
        )
    )
    parser.add_argument(
        "--config", type=Path, default=HERE / "three_goal_config.yaml"
    )
    parser.add_argument(
        "--stage",
        choices=("prepare", "train", "adapt", "all"),
        default="all",
    )
    parser.add_argument("--smoke", action="store_true")
    parser.add_argument("--rebuild-data", action="store_true")
    parser.add_argument(
        "--resume-checkpoint",
        type=Path,
        help="Load an existing three-goal checkpoint before online adaptation.",
    )
    parser.add_argument(
        "--run-name",
        help="Write this run to a sibling directory without replacing prior output.",
    )
    return parser.parse_args()


def apply_smoke_config(config: dict[str, Any]) -> None:
    config["paths"]["output_dir"] = (
        config["paths"]["output_dir"] / "smoke"
    )
    config["training"].update(epochs=2, batch_size=64)
    config["planner"].update(num_candidates=8, horizon_blocks=2)
    config["online_training"].update(
        episodes=2,
        max_steps=20,
        warmup_samples=2,
        batch_size=8,
    )


def process_states(predicate_targets: np.ndarray) -> np.ndarray:
    states = np.full(len(predicate_targets), GO_ALIGN, dtype=np.int64)
    states[predicate_targets[:, ALIGNED] >= 0.5] = GO_GRASP
    complete_process = (
        (predicate_targets[:, GRASPED] >= 0.5)
        | (predicate_targets[:, NEAR_GOAL] >= 0.5)
        | (predicate_targets[:, RELEASED] >= 0.5)
        | (predicate_targets[:, RETREATED] >= 0.5)
        | (predicate_targets[:, COMPLETE] >= 0.5)
    )
    states[complete_process] = GO_COMPLETE
    return states


def first_future_true(
    labels: np.ndarray,
    start: int,
    predicate: int,
    fallback: int,
) -> int:
    matches = np.flatnonzero(labels[start:, predicate] >= 0.5)
    return start + int(matches[0]) if len(matches) else fallback


def prepare_three_goal_dataset(
    config: dict[str, Any],
    destination: Path,
) -> dict[str, Any]:
    source = config["paths"]["source_dataset"]
    if not source.exists():
        raise FileNotFoundError(f"Source recovery dataset missing: {source}")

    with np.load(source) as dataset:
        arrays = {name: np.asarray(dataset[name]) for name in dataset.files}

    predicates = arrays["predicate_targets"].astype(np.float32)
    episode_ids = arrays["episode_ids"].astype(np.int64)
    states = process_states(predicates)
    targets = np.empty_like(arrays["latents"], dtype=np.float32)
    next_targets = np.empty_like(targets)
    next_states = np.empty_like(states)
    rewards = np.zeros(len(states), dtype=np.float32)
    lookahead = int(config["dataset"]["complete_lookahead_steps"])
    training = config["training"]

    for episode in np.unique(episode_ids):
        indices = np.flatnonzero(episode_ids == episode)
        labels = predicates[indices]
        episode_states = states[indices]
        terminal = len(indices) - 1
        endpoints = np.empty(len(indices), dtype=np.int64)

        for local_index, state_id in enumerate(episode_states):
            fallback = min(local_index + lookahead, terminal)
            if state_id == GO_ALIGN:
                endpoint = first_future_true(
                    labels, local_index, ALIGNED, fallback
                )
            elif state_id == GO_GRASP:
                endpoint = first_future_true(
                    labels, local_index, GRASPED, fallback
                )
            else:
                endpoint = fallback
                complete_matches = np.flatnonzero(
                    labels[local_index : fallback + 1, COMPLETE] >= 0.5
                )
                if len(complete_matches):
                    endpoint = local_index + int(complete_matches[0])
            endpoints[local_index] = endpoint
            targets[indices[local_index]] = arrays["latents"][
                indices[endpoint]
            ]

        for local_index, global_index in enumerate(indices):
            next_local = min(local_index + 1, terminal)
            next_global = indices[next_local]
            next_states[global_index] = episode_states[next_local]
            next_targets[global_index] = targets[next_global]
            if local_index == terminal:
                continue
            reward = -float(training["step_penalty"])
            if episode_states[next_local] > episode_states[local_index]:
                reward += float(training["state_transition_reward"])
            elif episode_states[next_local] < episode_states[local_index]:
                reward -= float(training["recovery_penalty"])
            if labels[next_local, COMPLETE] >= 0.5:
                reward += float(training["success_reward"])
            rewards[global_index] = reward

    converted = {
        "previous_latents": arrays["previous_latents"].astype(np.float32),
        "latents": arrays["latents"].astype(np.float32),
        "next_latents": arrays["next_latents"].astype(np.float32),
        "goal_latents": arrays["goal_latents"].astype(np.float32),
        "keyframe_target_latents": targets,
        "next_keyframe_target_latents": next_targets,
        "action_blocks": arrays["action_blocks"].astype(np.float32),
        "state_ids": states,
        "next_state_ids": next_states,
        "predicate_targets": predicates,
        "rewards": rewards,
        "dones": arrays["dones"].astype(np.float32),
        "episode_ids": episode_ids,
        "episode_successes": arrays["episode_successes"].astype(np.int64),
    }
    repeat_factors = np.asarray(
        config["dataset"]["state_repeat_factors"], dtype=np.int64
    )
    if repeat_factors.shape != (len(PROCESS_NAMES),):
        raise ValueError(
            "dataset.state_repeat_factors must contain one value per process state."
        )
    selection = np.repeat(
        np.arange(len(states), dtype=np.int64), repeat_factors[states]
    )
    converted = {
        name: values[selection] for name, values in converted.items()
    }
    destination.parent.mkdir(parents=True, exist_ok=True)
    np.savez_compressed(destination, **converted)
    counts = {
        name: int(np.sum(converted["state_ids"] == index))
        for index, name in enumerate(PROCESS_NAMES)
    }
    return {
        "source": str(source),
        "destination": str(destination),
        "samples": int(len(selection)),
        "episodes": int(len(np.unique(episode_ids))),
        "state_counts": counts,
        "complete_lookahead_steps": lookahead,
        "state_repeat_factors": repeat_factors.tolist(),
    }


class ThreeGoalStateMachine:
    """Ordered macro goals with hysteresis and physical recovery."""

    def __init__(self, settings: dict[str, Any]) -> None:
        self.settings = settings
        self.state = GO_ALIGN
        self.pending_state = GO_ALIGN
        self.pending_streak = 0
        self.loss_streak = 0
        self.complete_streak = 0
        self.cooldown = 0
        self.steps_in_state = 0
        self.recoveries = 0
        self.visually_complete = False
        self.grasp_achieved = False
        self.grasp_reset_steps_remaining = 0
        self.grasp_attempts = 0

    def initialize(self, probabilities: np.ndarray) -> int:
        del probabilities
        self.state = GO_ALIGN
        self.pending_state = GO_ALIGN
        self.pending_streak = 0
        self.loss_streak = 0
        self.complete_streak = 0
        self.cooldown = 0
        self.steps_in_state = 0
        self.recoveries = 0
        self.visually_complete = False
        self.grasp_achieved = False
        self.grasp_reset_steps_remaining = 0
        self.grasp_attempts = 0
        return self.state

    def _candidate(self, probabilities: np.ndarray) -> tuple[int, bool]:
        forced = False
        aligned = probabilities[ALIGNED]
        grasped = probabilities[GRASPED]
        near_goal = probabilities[NEAR_GOAL]
        released = probabilities[RELEASED]

        if self.state == GO_ALIGN:
            if self.grasp_reset_steps_remaining > 0:
                self.grasp_reset_steps_remaining -= 1
                return GO_ALIGN, False
            if aligned >= float(self.settings["aligned_enter_threshold"]):
                return GO_GRASP, False
            return GO_ALIGN, False

        if self.state == GO_GRASP:
            if grasped >= float(self.settings["grasped_enter_threshold"]):
                return GO_COMPLETE, False
            if aligned < float(self.settings["aligned_exit_threshold"]):
                self.loss_streak += 1
            else:
                self.loss_streak = 0
            timed_out = self.steps_in_state >= int(
                self.settings["max_state_steps"][GO_GRASP]
            )
            attempt_finished = self.steps_in_state >= int(
                self.settings["grasp_attempt_steps"]
            )
            if self.loss_streak >= int(
                self.settings["loss_consecutive_frames"]
            ) or attempt_finished or timed_out:
                forced = attempt_finished or timed_out
                return GO_ALIGN, forced
            return GO_GRASP, False

        release_is_expected = (
            near_goal >= float(self.settings["near_goal_threshold"])
            or released >= float(self.settings["released_threshold"])
        )
        if (
            not release_is_expected
            and grasped < float(self.settings["grasped_exit_threshold"])
        ):
            self.loss_streak += 1
        else:
            self.loss_streak = 0
        if self.loss_streak >= int(self.settings["loss_consecutive_frames"]):
            if aligned >= float(self.settings["aligned_enter_threshold"]):
                return GO_GRASP, False
            return GO_ALIGN, False
        return GO_COMPLETE, False

    def observe(self, probabilities: np.ndarray) -> recovery.StateTransition:
        previous = self.state
        self.steps_in_state += 1
        self.cooldown = max(0, self.cooldown - 1)
        if (
            self.state == GO_COMPLETE
            and self.grasp_achieved
            and probabilities[COMPLETE]
            >= float(self.settings["complete_threshold"])
        ):
            self.complete_streak += 1
        else:
            self.complete_streak = 0
        self.visually_complete = self.complete_streak >= int(
            self.settings["complete_consecutive_frames"]
        )
        if self.visually_complete:
            return recovery.StateTransition(
                previous, self.state, False, False, False, True
            )

        desired, forced = self._candidate(probabilities)
        if desired == self.state:
            self.pending_state = self.state
            self.pending_streak = 0
            return recovery.StateTransition(
                previous, self.state, False, False, forced, False
            )

        if desired == self.pending_state:
            self.pending_streak += 1
        else:
            self.pending_state = desired
            self.pending_streak = 1
        required = int(self.settings["transition_consecutive_frames"])
        if desired < self.state:
            required = 1
        if self.cooldown > 0 or self.pending_streak < required:
            return recovery.StateTransition(
                previous, self.state, False, False, forced, False
            )

        self.state = desired
        if previous == GO_GRASP and desired == GO_COMPLETE:
            self.grasp_achieved = True
        elif previous == GO_GRASP and desired == GO_ALIGN:
            self.grasp_attempts += 1
            self.grasp_reset_steps_remaining = int(
                self.settings["grasp_reset_open_steps"]
            )
        self.pending_state = desired
        self.pending_streak = 0
        self.loss_streak = 0
        self.steps_in_state = 0
        self.cooldown = int(self.settings["transition_cooldown_steps"])
        rollback = self.state < previous
        if rollback:
            self.recoveries += 1
        return recovery.StateTransition(
            previous, self.state, True, rollback, forced, False
        )


@torch.inference_mode()
def propose_and_score(
    *,
    actor,
    target_net,
    critic,
    world_model,
    previous: torch.Tensor,
    current: torch.Tensor,
    goal: torch.Tensor,
    state_id: int,
    action_mean: np.ndarray,
    action_scale: np.ndarray,
    settings: dict[str, Any],
    rng: np.random.Generator,
) -> dict[str, Any]:
    device = current.device
    count = int(settings["num_candidates"])
    horizon = int(settings["horizon_blocks"])
    block = actor.action_block
    action_dim = actor.action_dim
    actual_state = torch.full(
        (1,), state_id, dtype=torch.long, device=device
    )
    keyframe_target = target_net(previous, current, goal, actual_state)
    candidate_previous = previous.expand(count, -1).clone()
    candidate_current = current.expand(count, -1).clone()
    candidate_goal = goal.expand(count, -1)
    candidate_target = keyframe_target.expand(count, -1)
    candidate_state = actual_state.expand(count)
    mean_tensor = torch.as_tensor(action_mean, device=device)
    scale_tensor = torch.as_tensor(action_scale, device=device)
    exploration = float(settings["exploration_std"])
    blocks = []
    values_along_path = []
    predicted_latents = []

    for _ in range(horizon):
        mean_block = actor.mean(
            candidate_previous,
            candidate_current,
            candidate_target,
            candidate_goal,
            candidate_state,
        ).reshape(count, block, action_dim)
        noise = torch.from_numpy(
            rng.normal(
                0.0,
                exploration,
                size=(count, block, action_dim),
            ).astype(np.float32)
        ).to(device)
        noise[0].zero_()
        raw_block = (mean_block + noise).clamp(-1.0, 1.0)
        if state_id == GO_ALIGN:
            raw_block[..., 4].clamp_(max=-0.35)
        elif state_id == GO_GRASP:
            raw_block[..., 4].clamp_(min=0.35)
        normalized = ((raw_block - mean_tensor) / scale_tensor).reshape(
            count, -1
        )
        next_latent = base.predict_latent_block(
            world_model, candidate_current, normalized
        )
        step_value, _ = recovery.critic_statistics(
            critic,
            candidate_current,
            next_latent,
            candidate_target,
            candidate_goal,
            candidate_state,
        )
        blocks.append(raw_block)
        values_along_path.append(step_value)
        predicted_latents.append(next_latent)
        candidate_previous, candidate_current = (
            candidate_current,
            next_latent,
        )
        exploration *= float(settings["exploration_decay"])

    plans = torch.stack(blocks, dim=1)
    flattened = plans.reshape(count, horizon * block, action_dim)
    terminal = predicted_latents[-1]
    terminal_value, uncertainty = recovery.critic_statistics(
        critic,
        candidate_previous,
        terminal,
        candidate_target,
        candidate_goal,
        candidate_state,
    )
    trajectory_value = torch.stack(values_along_path, dim=1).mean(dim=1)
    short_cost = (terminal - candidate_target).square().mean(dim=-1)
    behavior_deviation = (plans - plans[0:1]).square().mean(dim=(1, 2, 3))
    smoothness = (
        flattened[:, 1:] - flattened[:, :-1]
    ).square().mean(dim=(1, 2))
    score = (
        -float(settings["short_target_coefficient"]) * short_cost
        + float(settings["terminal_value_coefficient"]) * terminal_value
        + float(settings["trajectory_value_coefficient"]) * trajectory_value
        - float(settings["uncertainty_coefficient"]) * uncertainty
        - float(settings["action_prior_coefficient"]) * behavior_deviation
        - float(settings["action_smoothness_coefficient"]) * smoothness
    )
    best_index = int(torch.argmax(score).item())
    elite_count = min(int(settings["elite_count"]), count)
    elite_scores, elite_indices = torch.topk(score, elite_count)
    temperature = max(float(settings["elite_temperature"]), 1e-6)
    weights = torch.softmax(
        (elite_scores - elite_scores.max()) / temperature, dim=0
    )
    elite_plan = (
        flattened[elite_indices] * weights[:, None, None]
    ).sum(dim=0)
    return {
        "flattened": flattened,
        "score": score,
        "best_index": best_index,
        "keyframe_target": keyframe_target,
        "elite_plan": elite_plan,
        "terminal_value": terminal_value,
        "trajectory_value": trajectory_value,
        "uncertainty": uncertainty,
        "short_cost": short_cost,
    }


def active_semantic_progress(
    before: np.ndarray,
    after: np.ndarray,
    state_id: int,
) -> float:
    if state_id == GO_ALIGN:
        return float(after[ALIGNED] - before[ALIGNED])
    if state_id == GO_GRASP:
        alignment_drop = min(0.0, float(after[ALIGNED] - before[ALIGNED]))
        return float(after[GRASPED] - before[GRASPED]) + 0.25 * alignment_drop
    if before[NEAR_GOAL] < 0.65:
        grasp_drop = min(0.0, float(after[GRASPED] - before[GRASPED]))
        return float(after[NEAR_GOAL] - before[NEAR_GOAL]) + 0.25 * grasp_drop
    if before[RELEASED] < 0.65:
        return float(after[RELEASED] - before[RELEASED])
    return float(after[COMPLETE] - before[COMPLETE])


def semantic_safety_ok(
    before: np.ndarray,
    after: np.ndarray,
    state_id: int,
) -> bool:
    if state_id == GO_GRASP:
        return bool(
            after[ALIGNED] >= before[ALIGNED] - 0.15
            or after[GRASPED] > before[GRASPED]
        )
    if state_id == GO_COMPLETE:
        if before[NEAR_GOAL] < 0.65 and before[RELEASED] < 0.65:
            return bool(after[GRASPED] >= before[GRASPED] - 0.10)
        return bool(after[NEAR_GOAL] >= before[NEAR_GOAL] - 0.10)
    return True


def install_three_goal_runtime() -> None:
    recovery.STATE_NAMES = PROCESS_NAMES
    recovery.RecoveryStateMachine = ThreeGoalStateMachine
    recovery.propose_and_score = propose_and_score
    recovery.active_semantic_progress = active_semantic_progress
    recovery.semantic_safety_ok = semantic_safety_ok


def main() -> None:
    args = parse_args()
    config = base.load_config(args.config.resolve())
    if args.run_name:
        run_name = Path(args.run_name)
        if run_name.name != args.run_name or args.run_name in (".", ".."):
            raise ValueError("--run-name must be a single directory name.")
        config["paths"]["output_dir"] = (
            config["paths"]["output_dir"].parent / run_name
        )
    if args.smoke:
        apply_smoke_config(config)
    if str(config["device"]).startswith("cuda") and not torch.cuda.is_available():
        raise RuntimeError("CUDA is required for three-goal LeWM planning.")

    recovery.set_seed(int(config["seed"]))
    device = torch.device(config["device"])
    output_dir = config["paths"]["output_dir"]
    output_dir.mkdir(parents=True, exist_ok=True)
    dataset_path = output_dir / "data" / "three_goal_latents.npz"
    offline_checkpoint = output_dir / "checkpoints" / "offline.pt"
    final_checkpoint = output_dir / "checkpoints" / "online_final.pt"
    log_dir = output_dir / "logs"
    video_dir = output_dir / "videos"
    summary_path = output_dir / "summary.json"
    resume_checkpoint = None
    if args.resume_checkpoint is not None:
        resume_checkpoint = args.resume_checkpoint.expanduser()
        if not resume_checkpoint.is_absolute():
            resume_checkpoint = (Path.cwd() / resume_checkpoint).resolve()
        if not resume_checkpoint.exists():
            raise FileNotFoundError(
                f"Resume checkpoint missing: {resume_checkpoint}"
            )
    base.save_json(output_dir / "resolved_config.json", config)
    summary: dict[str, Any] = {}

    if args.stage in ("prepare", "all"):
        if args.rebuild_data or not dataset_path.exists():
            summary["dataset"] = prepare_three_goal_dataset(
                config, dataset_path
            )
        else:
            with np.load(dataset_path) as dataset:
                summary["dataset"] = {
                    "reused": True,
                    "samples": int(len(dataset["latents"])),
                    "destination": str(dataset_path),
                }
        if args.stage == "prepare":
            base.save_json(summary_path, summary)
            print(json.dumps(base.json_value(summary), indent=2))
            return

    action_mean, action_scale = base.load_action_stats(
        config["paths"]["action_dataset"]
    )
    trained_models = None
    if args.stage in ("train", "all"):
        if not dataset_path.exists():
            raise FileNotFoundError(
                "Three-goal dataset missing. Run --stage prepare first."
            )
        trained_models = recovery.train_offline(
            config,
            dataset_path,
            device,
            offline_checkpoint,
            log_dir / "offline_training.jsonl",
            action_mean,
            action_scale,
        )
        summary["offline_training"] = {
            "checkpoint": str(offline_checkpoint)
        }

    if args.stage in ("adapt", "all"):
        source_checkpoint = resume_checkpoint or offline_checkpoint
        if trained_models is None or resume_checkpoint is not None:
            if not source_checkpoint.exists():
                raise FileNotFoundError(
                    f"Source checkpoint missing: {source_checkpoint}"
                )
            (
                semantic_net,
                target_net,
                actor,
                critic,
                action_mean,
                action_scale,
            ) = recovery.load_checkpoint(offline_checkpoint, config, device)
        else:
            semantic_net, target_net, actor, critic = trained_models
        for model in (semantic_net, target_net, critic):
            model.eval().requires_grad_(False)
        transform = base.build_transform(int(config["image_size"]))
        world_model = base.load_world_model(
            config["paths"]["model_dir"], device
        )
        install_three_goal_runtime()
        summary["online_training"] = recovery.run_online_training(
            config=config,
            semantic_net=semantic_net,
            target_net=target_net,
            actor=actor,
            critic=critic,
            world_model=world_model,
            transform=transform,
            device=device,
            action_mean=action_mean,
            action_scale=action_scale,
            log_path=log_dir / "online_training.jsonl",
            video_dir=video_dir,
        )
        recovery.save_checkpoint(
            final_checkpoint,
            config,
            semantic_net,
            target_net,
            actor,
            critic,
            action_mean,
            action_scale,
            {"online_training": summary["online_training"]},
        )
        summary["online_training"]["checkpoint"] = str(final_checkpoint)
        summary["online_training"]["source_checkpoint"] = str(
            offline_checkpoint
        )

    base.save_json(summary_path, summary)
    print(json.dumps(base.json_value(summary), indent=2))


if __name__ == "__main__":
    main()
